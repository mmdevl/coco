# coco default shell config

[[ -f /usr/share/bash-completion/bash_completion ]] && source /usr/share/bash-completion/bash_completion

alias ls='ls --color=auto'

parse_git_branch() {
  git branch --show-current 2>/dev/null
}

if [[ -n "$PS1" ]]; then
  export PS1='\[\e[32m\]\u@🥥\[\e[0m\]:\[\e[34m\]\w\[\e[33m\]$(git branch --show-current 2>/dev/null)\[\e[0m\]\$ '
fi

export HISTFILE=~/.bash_history
export HISTSIZE=10000
export HISTFILESIZE=20000

# claude's normal TUI login screen (QR/box borders) isn't selectable in a
# plain terminal; --ax-screen-reader renders flat text instead so the auth
# URL can actually be copied.
claude-login() {
  claude --ax-screen-reader auth login "$@"
}
export -f claude-login

set -o vi
# vi:ts=4:sts=4:sw=4:ft=bash:ai:et
